{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.9.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -b tsconfig.json",
    "build:watch": "tsc -b tsconfig.json -w",
    "test:ui": "vitest --ui --coverage",
    "test": "vitest --run --coverage",
    "release": "pnpm i && pnpm -r build && bumpp packages/*/package.json --commit --push --tag"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^26.0.0",
    "@unocss/eslint-plugin": "^66.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^5.0.0",
    "bumpp": "^10.4.1",
    "commitlint": "^19.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-format": "^1.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "^2.1.2",
      "vite": "^6.4.4"
    }
  }
}
